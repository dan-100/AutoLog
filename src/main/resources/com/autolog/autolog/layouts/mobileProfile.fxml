<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<BorderPane maxHeight="-Infinity"
            maxWidth="-Infinity"
            minHeight="-Infinity"
            minWidth="-Infinity"
            prefHeight="760.0"
            prefWidth="360.0"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.autolog.autolog.controller.VehicleSetupController">

   <center>
      <AnchorPane maxHeight="-Infinity"
                  maxWidth="-Infinity"
                  minHeight="-Infinity"
                  minWidth="-Infinity"
                  prefHeight="760.0"
                  prefWidth="360.0"
                  BorderPane.alignment="CENTER">

         <children>
            <Pane fx:id="headerColor"
                  prefHeight="122.0"
                  prefWidth="360.0"
                  style="-fx-background-color: #033375;">

               <children>
                  <Text fx:id="dashboardLabel"
                        fill="WHITE"
                        layoutX="60.0"
                        layoutY="94.0"
                        strokeType="OUTSIDE"
                        strokeWidth="0.0"
                        text="Vehicle Profile">

                     <font>
                        <Font name="Helvetica Neue Bold" size="28.0"/>
                     </font>
                  </Text>

                  <Button fx:id="saveButton"
                          layoutX="281.0"
                          layoutY="53.0"
                          mnemonicParsing="false"
                          prefHeight="57.0"
                          prefWidth="65.0"
                          style="-fx-background-color: #033375;">

                     <graphic>
                        <ImageView fitHeight="58.0"
                                   fitWidth="58.0"
                                   preserveRatio="true"/>
                     </graphic>
                  </Button>

                  <Button fx:id="backButton"
                          layoutY="66.0"
                          mnemonicParsing="false"
                          prefHeight="31.0"
                          prefWidth="45.0"
                          style="-fx-background-color: #033375;">

                     <graphic>
                        <ImageView fitHeight="42.0"
                                   fitWidth="42.0"
                                   preserveRatio="true">

                           <image>
                              <Image url="@../chevron-left-solid-2.png"/>
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
               </children>
            </Pane>

            <Text fx:id="yearLabel"
                  layoutX="26.0"
                  layoutY="168.0"
                  strokeType="OUTSIDE"
                  strokeWidth="0.0"
                  text="Year"
                  wrappingWidth="152.21630859375">

               <font>
                  <Font size="26.0"/>
               </font>
            </Text>

            <TextField fx:id="yearField"
                       layoutX="26.0"
                       layoutY="175.0"
                       prefHeight="44.0"
                       prefWidth="308.0"
                       promptText="ex. 2023">

               <font>
                  <Font size="26.0"/>
               </font>
            </TextField>

            <Text fx:id="makeLabel"
                  layoutX="26.0"
                  layoutY="278.0"
                  strokeType="OUTSIDE"
                  strokeWidth="0.0"
                  text="Make"
                  wrappingWidth="65.21630859375">

               <font>
                  <Font size="26.0"/>
               </font>
            </Text>

            <TextField fx:id="makeField"
                       layoutX="26.0"
                       layoutY="284.0"
                       prefHeight="44.0"
                       prefWidth="308.0"
                       promptText="ex. Porsche">

               <font>
                  <Font size="26.0"/>
               </font>
            </TextField>

            <Text fx:id="modelLabel"
                  layoutX="26.0"
                  layoutY="381.0"
                  strokeType="OUTSIDE"
                  strokeWidth="0.0"
                  text="Model"
                  wrappingWidth="118.21630859375">

               <font>
                  <Font size="26.0"/>
               </font>
            </Text>

            <TextField fx:id="modelField"
                       layoutX="26.0"
                       layoutY="389.0"
                       prefHeight="44.0"
                       prefWidth="308.0"
                       promptText="ex. Taycan">

               <font>
                  <Font size="26.0"/>
               </font>
            </TextField>

            <Text fx:id="mileageLabel"
                  layoutX="25.0"
                  layoutY="496.0"
                  strokeType="OUTSIDE"
                  strokeWidth="0.0"
                  text="Mileage"
                  wrappingWidth="132.21630859375">

               <font>
                  <Font size="26.0"/>
               </font>
            </Text>

            <TextField fx:id="mileageField"
                       layoutX="26.0"
                       layoutY="504.0"
                       prefHeight="44.0"
                       prefWidth="308.0"
                       promptText="ex. 15000">

               <font>
                  <Font size="26.0"/>
               </font>
            </TextField>

            <Button fx:id="createButton"
                    layoutX="102.0"
                    layoutY="600.0"
                    mnemonicParsing="false"
                    onAction="#handleContinue"
                    prefHeight="54.0"
                    prefWidth="152.0"
                    text="Create Profile">

               <font>
                  <Font size="20.0"/>
               </font>
            </Button>
         </children>
      </AnchorPane>
   </center>
</BorderPane>