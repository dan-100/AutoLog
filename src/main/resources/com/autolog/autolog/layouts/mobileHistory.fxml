<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane
        maxHeight="-Infinity"
        maxWidth="-Infinity"
        minHeight="-Infinity"
        minWidth="-Infinity"
        prefHeight="760.0"
        prefWidth="360.0"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.autolog.autolog.controller.ServiceHistoryController">

   <top>
      <Pane
              prefHeight="118.0"
              prefWidth="360.0"
              style="-fx-background-color: #033375;"
              BorderPane.alignment="CENTER">

         <children>
            <Button
                    fx:id="backButton"
                    layoutX="12.0"
                    layoutY="65.0"
                    mnemonicParsing="false"
                    onAction="#returnToDashboard"
                    prefHeight="40.0"
                    prefWidth="40.0"
                    text="‹"
                    style="-fx-background-color: transparent;
                               -fx-text-fill: white;
                               -fx-font-size: 30px;
                               -fx-padding: 0;" />

            <Label
                    layoutX="68.0"
                    layoutY="76.0"
                    text="Maintenance History"
                    textFill="WHITE">
               <font>
                  <Font name="System Bold" size="22.0" />
               </font>
            </Label>
         </children>
      </Pane>
   </top>

   <center>
      <AnchorPane
              prefHeight="642.0"
              prefWidth="360.0"
              BorderPane.alignment="CENTER">

         <children>
            <Pane
                    layoutX="18.0"
                    layoutY="19.0"
                    prefHeight="115.0"
                    prefWidth="324.0"
                    style="-fx-background-color: #033375;
                               -fx-background-radius: 4;">

               <children>
                  <Label
                          alignment="CENTER"
                          layoutX="15.0"
                          layoutY="18.0"
                          prefWidth="294.0"
                          text="Total Spent on Maintenance"
                          textAlignment="CENTER"
                          textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="19.0" />
                     </font>
                  </Label>

                  <Label
                          fx:id="totalAmountLabel"
                          alignment="CENTER"
                          layoutX="15.0"
                          layoutY="55.0"
                          prefWidth="294.0"
                          text="\$0.00"
                          textAlignment="CENTER"
                          textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="24.0" />
                     </font>
                  </Label>
               </children>
            </Pane>

            <ScrollPane
                    fx:id="summaryList"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    layoutX="18.0"
                    layoutY="145.0"
                    prefHeight="475.0"
                    prefWidth="324.0"
                    style="-fx-background-color: transparent;">

               <content>
                  <VBox
                          fx:id="summaryEvents"
                          fillWidth="true"
                          prefWidth="307.0"
                          spacing="10.0"
                          style="-fx-background-color: #f4f4f4;
                                       -fx-padding: 8;" />
               </content>
            </ScrollPane>
         </children>
      </AnchorPane>
   </center>
</BorderPane>
